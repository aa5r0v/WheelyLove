# WheelyLove production environment - TEMPLATE.
# Real file: /srv/wheelylove/.env   (owner root, mode 600). NEVER commit the real file.
#
# Format rules (the scripts parse this file, compose reads it too):
#   KEY=value     one per line, NO quotes, NO spaces around "=", NO "$" characters in values.
#   Generate passwords/secrets with:  openssl rand -hex 24      (URL-safe on purpose)
# deploy.sh refuses to run while any value still says CHANGE_ME.
# install.sh creates /srv/wheelylove/.env from this template and fills in
# POSTGRES_PASSWORD, CRON_SECRET and BETTER_AUTH_SECRET with random values.

# ---------------------------------------------------------------- Postgres (container "db")
POSTGRES_USER=wheely
POSTGRES_DB=wheelylove
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# DATABASE_URL is BUILT by docker-compose from the three values above
# (postgres://USER:PASSWORD@db:5432/DB) - do not set it here.
# For reference / local tools only:
# DATABASE_URL=postgres://wheely:<POSTGRES_PASSWORD>@db:5432/wheelylove

# ---------------------------------------------------------------- Public URL
# BAKED AT BUILD TIME (build arg). Changing it needs a new deploy (new build).
# Temporary host now; when the custom domain arrives, change it and redeploy.
NEXT_PUBLIC_APP_URL=https://wheelylove.purepoint.bg

# ---------------------------------------------------------------- Better Auth (self-hosted)
# The app also reads BETTER_AUTH_URL; keep it equal to NEXT_PUBLIC_APP_URL.
BETTER_AUTH_SECRET=CHANGE_ME_BETTER_AUTH_SECRET
BETTER_AUTH_URL=https://wheelylove.purepoint.bg

# ---------------------------------------------------------------- Resend (email)
RESEND_API_KEY=CHANGE_ME_re_key
# Verified sending domain, WITHOUT "reservations@" (code builds reservations@<domain>)
RESEND_EMAIL_DOMAIN=CHANGE_ME_example.com

# ---------------------------------------------------------------- Uploads (local disk)
# Bind-mounted from /srv/wheelylove/uploads by docker-compose; served by nginx at /uploads/.
UPLOAD_DIR=/data/uploads

# ---------------------------------------------------------------- Cron
# Bearer secret for /api/cron/reminders. Read by the systemd timer from this file
# (never put on a command line).
CRON_SECRET=CHANGE_ME_CRON_SECRET

# ---------------------------------------------------------------- Optional
# Path used by the container health check (default "/"). Set to /api/health if you add such a route.
# HEALTH_PATH=/
